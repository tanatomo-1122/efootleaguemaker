# =====================================================================
# Supabase — Database
#   Supabase ダッシュボード > Project Settings > Database > Connection string
#   「Connection pooling」(Transaction mode / ポート 6543) の URI を使ってください。
#   Vercel のようなサーバーレス環境では直接接続(5432)だと接続数が枯渇します。
# =====================================================================
DATABASE_URL=postgresql://postgres.xxxxxxxxxxxx:YOUR-PASSWORD@aws-0-ap-northeast-1.pooler.supabase.com:6543/postgres

# 画面が固まる・応答が返らないときの逃げ道（省略可）
#   PGPOOL_MAX=1              … クエリを1本ずつ流す（同時実行を完全にやめる）
#   PG_STATEMENT_TIMEOUT_MS   … 1クエリの上限。既定 15000ms
# 原因の切り分けには `npm run doctor` が使えます。
# PGPOOL_MAX=1

# =====================================================================
# Supabase — Storage（スカッド画像・試合結果画像）
#   Project Settings > API から取得します。
#   SERVICE_ROLE_KEY は絶対に公開しないでください（サーバー側でのみ使用）。
# =====================================================================
NEXT_PUBLIC_SUPABASE_URL=https://xxxxxxxxxxxx.supabase.co
SUPABASE_SERVICE_ROLE_KEY=eyJhbGciOi...
SUPABASE_STORAGE_BUCKET=efootleague

# =====================================================================
# 試合結果スクショの自動読み取り(GPT-4o mini のビジョン機能)
#   未設定でも手入力でリーグは回せます。
# =====================================================================
OPENAI_API_KEY=sk-xxxxxxxxxxxxxxxx
OPENAI_MODEL=gpt-4o-mini
# 読み取りの打ち切り時間（省略可・既定 40000ms）。
# 超えたら「手入力で登録してください」に落ちるだけで、サーバーは止まりません。
# OPENAI_TIMEOUT_MS=40000

# =====================================================================
# EFLランク（レーティング）
#   「公式リーグ」(重要度 I=40) を作れるユーザー名をカンマ区切りで指定します。
#   未設定なら、誰も公式リーグを作れません（一般・賞金ありは誰でも作れます）。
# =====================================================================
# OFFICIAL_ORGANIZERS=TOMOYA_10
